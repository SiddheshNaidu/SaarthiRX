# ══════════════════════════════════════════════════════════════════════════════
# SaarthiRx — Environment Variables Template
# ══════════════════════════════════════════════════════════════════════════════
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your actual values in the .env file
#   3. Never commit .env to Git (it's already listed in .gitignore)
#
# For Vercel deployment, add these same variables in:
#   Vercel Dashboard → Project → Settings → Environment Variables
# ══════════════════════════════════════════════════════════════════════════════


# ─── Google Gemini AI ────────────────────────────────────────────────────────
# Free key → https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE


# ─── Firebase ────────────────────────────────────────────────────────────────
# Firebase Console → Project Settings → General → Your Apps → Web App
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID_HERE
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID_HERE
VITE_FIREBASE_APP_ID=YOUR_APP_ID_HERE


# ─── Firebase App Check (Optional) ───────────────────────────────────────────
# reCAPTCHA v3 site key → https://www.google.com/recaptcha/admin
# Leave blank to disable App Check
VITE_RECAPTCHA_SITE_KEY=


# ─── Dev Tools ───────────────────────────────────────────────────────────────
VITE_SHOW_DEVTOOLS=false
